/bin/
/web/node_modules/
/web/dist/

# Embedded dist for go:embed. Only .gitkeep is tracked so the directory
# exists on a fresh clone; the SPA handler falls back to an in-code
# placeholder when no real index.html is embedded. `make web-build` copies
# the Vue dist in at build time (stays gitignored).
/internal/http/dist/*
!/internal/http/dist/.gitkeep

# Local env
.env
.env.local

# OS / IDE
.DS_Store
.idea/
.vscode/
*.swp

# Go
*.test
*.out
coverage.html
