# Postgres connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/premier_league?sslmode=disable

# HTTP listen port
PORT=8080

# Monte Carlo iterations for championship prediction. Higher = smoother
# probabilities; ~10000 stays under 100ms on a free Render dyno.
MC_ITERATIONS=10000

# RNG seed for the match simulator. 0 = time-based seed (non-deterministic).
RANDOM_SEED=0
